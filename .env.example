# Normally you don't edit this by hand: `make setup` writes .env for you from
# your gcx login. Fill it in manually only if setup can't detect a value.

# Your personal label. Every span, metric and log line carries it, so you can
# find your own telemetry on a shared stack.
ATTENDEE=jane-doe
SERVICE_NAMESPACE=homework-jane-doe

# Grafana Cloud OTLP endpoint and stack (instance) ID. 
#Grab these from your workshop dashboard or facilitator.
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-us-west-0.grafana.net/otlp
GRAFANA_CLOUD_INSTANCE_ID=123456

# Ingest token (Cloud Access Policy with metrics:write, logs:write, traces:write).
# Workshop: your facilitator hands it out.
GRAFANA_CLOUD_API_KEY=

# Port for the app UI on your machine.
APP_PORT=8080

# Your Grafana stack, for the App Observability links (make setup takes it from gcx).
GRAFANA_URL=https://<your-stack>.grafana.net
